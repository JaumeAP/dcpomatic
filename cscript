def test(target, options, test):
    target.set('LC_ALL', 'C')
    if target.platform == 'windows':
        cmd = 'run\\tests '
    else:
        cmd = 'run/tests --check --log_level=test_suite '
    if target.debug:
        cmd += '--backtrace '
    if test is not None:
        cmd += '-t %s' % test
    target.command(cmd)
