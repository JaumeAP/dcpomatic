sources = """
          content_binding.cc
          content_properties.cc
          film_binding.cc
          film_properties.cc
          lua_state.cc
          mapping_binding.cc
          units.cc
          warnings.cc
          """

def build(bld):
    if bld.env.STATIC_DCPOMATIC:
        obj = bld(features='cxx cxxstlib')
    else:
        obj = bld(features='cxx cxxshlib')

    obj.name   = 'libdcpomatic2-lua'
    obj.export_includes = ['..']
    obj.uselib = 'LUA BOOST_FILESYSTEM BOOST_THREAD BOOST_REGEX DCP SUB ZIP CXML ICU AVUTIL TTF '
    obj.source = sources
    obj.use    = 'libdcpomatic2'
    obj.target = 'dcpomatic2-lua'
